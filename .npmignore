# This file exists to stop .gitignore from deciding the npm tarball. When
# .npmignore is absent npm falls back to .gitignore, which excludes dist/ and
# dist-server/ - correct for the repo, wrong for the package, since those two ARE
# the published product: the built UI and the compiled server. The `files`
# allowlist in package.json decides what ships; this only keeps machine-local
# junk out of it.
node_modules/
config.json
*.log
.DS_Store
